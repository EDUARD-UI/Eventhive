# =============================================================================
# EventHive Frontend — Plantilla de Variables de Entorno
# =============================================================================

# Modo de conexión para desarrollo local:
#   'azure' -> Conecta a la API desplegada en Azure (Recomendado: datos reales y eventos listos)
#   'local' -> Conecta a tu Spring Boot local en http://localhost:8080/api
VITE_API_MODE=azure

# Servidor Remoto (Azure App Service)
VITE_API_URL=https://eventhive-bggyerbvhwa6akbq.brazilsouth-01.azurewebsites.net/api

# Servidor Local (Spring Boot)
VITE_LOCAL_API_URL=http://localhost:8080/api


