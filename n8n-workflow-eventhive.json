{
  "name": "EventHive AI Agent Assistant",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "eventhive-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "webhook-trigger-node",
      "name": "Webhook Trigger",
      "webhookId": "eventhive-chat"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "Eres HiveBot, el asistente virtual inteligente y amigable de la plataforma EventHive en Cartagena, Colombia.\n\nTus objetivos y conocimientos principales son:\n1. Orientar a los usuarios sobre eventos culturales, conciertos, festivales, obras y conferencias en Cartagena.\n2. Explicar cómo comprar boletos: los usuarios seleccionan su evento favorito en el catálogo, hacen clic en 'Comprar boletos' y reciben sus entradas con código QR digital.\n3. Informar sobre métodos de pago: tarjetas de crédito/débito (Visa, Mastercard), transferencias PSE, Nequi y Daviplata de forma 100% segura.\n4. Explicar a los organizadores cómo publicar eventos: deben registrarse con rol de Organización en la sección de Registro para publicar y gestionar sus eventos.\n5. Responder siempre con un tono cercano, profesional, claro y con calidez cartagenera usando emojis moderados."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        260,
        0
      ],
      "id": "ai-agent-node",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.7
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        200,
        220
      ],
      "id": "gemini-chat-model-node",
      "name": "Google Gemini Chat Model",
      "credentials": {
        "googlePalmApi": {
          "id": "CREDENCIAL_GEMINI",
          "name": "Google Gemini Account"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $('Webhook Trigger').item.json.body.sessionId || 'default_session' }}",
        "contextWindowLength": 10
      },
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        360,
        220
      ],
      "id": "window-buffer-memory-node",
      "name": "Window Buffer Memory"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"reply\": {{ JSON.stringify($json.output) }}\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        560,
        0
      ],
      "id": "respond-to-webhook-node",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Window Buffer Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}

